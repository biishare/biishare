NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Optional provider override. By default the app uses NEXT_PUBLIC_API_BASE_URL/auth/google and /auth/facebook.
NEXT_PUBLIC_GOOGLE_AUTH_URL=
NEXT_PUBLIC_FACEBOOK_AUTH_URL=

# Production notes:
# Use HTTPS URLs.
# Prefer frontend and API on the same site, for example app.example.com and api.example.com.
# Then configure the API with AUTH_COOKIE_DOMAIN=.example.com so server-rendered profile pages receive the session cookie.
